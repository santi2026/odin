---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  toolPage?: boolean;
}

const { title, description, toolPage = false } = Astro.props;
const themePage = ({'/herramientas/alarmas/':'preview-alarms','/herramientas/concentracion/':'preview-focus','/herramientas/cronometro-temporizador/':'preview-timer','/herramientas/mi-ip/':'preview-ip','/herramientas/reloj-negro/':'preview','/herramientas/relojes-del-mundo/':'preview-world'} as Record<string,string>)[Astro.url.pathname] || 'preview-home';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#070a14" />
    <title>{title}</title>
    <link rel="stylesheet" href={`/theme-light/${themePage}.css?v=3`} data-odin-theme-style />
    <link rel="stylesheet" href="/theme.css?v=3" data-odin-theme-style />
    <script is:inline src="/theme.js?v=2"></script></head>
  <body class:list={{ 'tool-page': toolPage }}>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="ODÍN, inicio">
        <span class="brand-mark" aria-hidden="true">✦</span>
        <span>ODÍN</span>
      </a>
      <nav aria-label="Navegación principal">
        {toolPage ? <a class="back-to-catalog" href="/#herramientas"><span aria-hidden="true">←</span> Catálogo</a> : <a href="/#herramientas">Catálogo</a>}
      </nav>
    </header>
    <main id="contenido"><slot /></main>
    <footer class="site-footer">
      <span>ODÍN · herramientas claras para cada día</span>
      <span>Privacidad primero · sin publicidad</span>
    </footer>
    <script>import '../../global-timer.js';</script>
  </body>
</html>
